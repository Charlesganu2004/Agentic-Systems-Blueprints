PORT=8787
HOST=127.0.0.1
KNOWLEDGE_NAMESPACE=default-project
MIN_KNOWLEDGE_SCORE=0.55

# CORS is disabled unless this exact browser origin is set.
CORS_ORIGIN=

# Required before setting HOST to a non-loopback address. Send as a Bearer token.
API_TOKEN=

# Optional hosted vector storage.
# Create a free/low-cost Upstash Vector index, then set:
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Optional model keys. Keep real values only in local .env or secret manager.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
