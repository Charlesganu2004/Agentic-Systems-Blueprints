{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceRecord",
  "type": "object",
  "required": ["id", "title", "url", "status"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "url": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["public", "private", "internal", "unverified", "deprecated"]
    },
    "owner": { "type": "string" },
    "notes": { "type": "string" },
    "lastReviewedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
